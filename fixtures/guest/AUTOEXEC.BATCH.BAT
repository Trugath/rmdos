@ECHO hi > TEST\OUT.TXT
SET FOO=BAR
IF EXIST TEST\OUT.TXT ECHO EXISTS
REN TEST\OUT.TXT TEST\RENAMED.TXT
IF EXIST TEST\RENAMED.TXT ECHO RENAMED
ECHO %FOO%
VER
GOTO AFTER_SKIP
ECHO BATCH FAIL
:AFTER_SKIP
PROMPT $p$g
ECHO PROMPT OK
DATE 07-31-2026
DATE
VERIFY ON
VERIFY
FOR %A IN (ONE TWO) DO ECHO %A
ECHO FOR OK
BREAK ON
BREAK
IF FOO==FOO ECHO IFSTR OK
IF NOT BAR==BAZ ECHO IFNOT OK
CALL SHIFT.BAT ONE TWO
REM this is a comment
PATH
PATH A:\BIN
ERASE TEST\RENAMED.TXT
IF NOT EXIST TEST\RENAMED.TXT ECHO ERASED
ECHO %0
ECHO CMD OK
ECHO ENV OK
ECHO hi|FIND "hi"
ECHO PIPE OK
CD NOSUCH
IF ERRORLEVEL 1 ECHO ELCD OK
CTTY NUL
CTTY CON
ECHO CTTY OK
ECHO BATCH OK
EXIT
ECHO AFTER EXIT
