@ECHO OFF
@ECHO hi > TEST\OUT.TXT
TYPE <TEST\SAMPLE.TXT >TEST\REDIR.TXT
FIND "HELLO" TEST\REDIR.TXT
IF ERRORLEVEL 1 ECHO REDIR2 FAIL ELSE ECHO REDIR2 OK
SET FOO=BAR
IF EXIST TEST\OUT.TXT ECHO EXISTS
REN TEST\OUT.TXT TEST\RENAMED.TXT
IF EXIST TEST\RENAMED.TXT ECHO RENAMED
ECHO %FOO%
VER
GOTO AFTER_SKIP
ECHO BATCH FAIL
:AFTER_SKIP
PROMPT $p$g
ECHO PROMPT OK
DATE 07-31-2026
DATE
TIME
VERIFY ON
VERIFY
FOR %A IN (ONE TWO) DO ECHO %A
ECHO FOR OK
BREAK ON
BREAK
IF FOO==FOO ECHO IFSTR OK
IF NOT BAR==BAZ ECHO IFNOT OK
IF EXIST NOSUCH.$$$ ECHO IFELSE BAD ELSE ECHO IFELSE OK
CALL SHIFT.BAT ONE TWO
REM this is a comment
PATH
PATH A:\BIN
ERASE TEST\RENAMED.TXT
IF NOT EXIST TEST\RENAMED.TXT ECHO ERASED
ECHO %0
ECHO CMD OK
COMMAND /C ECHO CMD_C OK
ECHO ENV OK
ECHO hi|FIND "hi"
ECHO PIPE OK
ECHO aaa|FIND "b" /V
IF ERRORLEVEL 1 ECHO FINDV FAIL ELSE ECHO FINDV OK
ECHO aaa|FIND /C "a"
IF ERRORLEVEL 1 ECHO FINDC FAIL ELSE ECHO FINDC OK
ECHO aaa|FIND /N "a"
IF ERRORLEVEL 1 ECHO FINDN FAIL ELSE ECHO FINDN OK
ECHO KEEP > PIPE.$$$
ECHO aa|FIND "aa"
IF EXIST PIPE.$$$ ECHO PIPEUNIQ OK
ERASE PIPE.$$$
CD NOSUCH
IF ERRORLEVEL 1 ECHO ELCD OK
CTTY NUL
CTTY CON
ECHO CTTY OK
SET N=0
:LOOP
IF %N%==1 GOTO LOOPDONE
SET N=1
GOTO LOOP
:LOOPDONE
ECHO GOTOLOOP OK
SET MSG=ENVEXP
ECHO %MSG% OK
ECHO OFF
ECHO ECHOCTL OK
CALL CALLTST.BAT CALLARG
CALL CALLTST2.BAT OUTER
VOL C:
ECHO VOLC OK
FOR %X IN (1) DO FOR %Y IN (A) DO ECHO %X%Y
ECHO FORNEST OK
NOSUCHCMD
IF ERRORLEVEL 1 ECHO BADCMD OK
DIR TEST\SAMPLE.TXT
ECHO DIRTIME OK
ECHO THREE > TEST\EXT1.TMP
ECHO FOUR > TEST\EXT2.TMP
BIN\DEL TEST\EXT?.TMP
IF EXIST TEST\EXT1.TMP GOTO DELWFAIL
IF EXIST TEST\EXT2.TMP GOTO DELWFAIL
ECHO ONE > TEST\DEL1.TMP
ECHO TWO > TEST\DEL2.TMP
DEL TEST\*.*
IF EXIST TEST\DEL1.TMP GOTO DELWFAIL
IF EXIST TEST\DEL2.TMP GOTO DELWFAIL
ECHO DELW OK
GOTO DELWDONE
:DELWFAIL
ECHO DELW FAIL
:DELWDONE
ECHO BATCH OK
EXIT
ECHO AFTER EXIT
