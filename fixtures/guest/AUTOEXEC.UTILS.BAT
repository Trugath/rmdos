BIN\MEM
BIN\FC TEST\SAMPLE.TXT TEST\SAMPLE.TXT
BIN\TREE
BIN\TREE /F
BIN\SORT TEST\SAMPLE.TXT
BIN\EDIT TEST\SAMPLE.TXT /Q
BIN\EDIT TEST\BIG.TXT /Q
BIN\DEBUG < TEST\DBG.SCR
BIN\MODE COM1: 9600,N,8,1
BIN\MODE 40
BIN\MODE CON
BIN\MODE BW80
IF ERRORLEVEL 1 ECHO MODEBW FAIL ELSE ECHO MODEBW OK
BIN\MODE CO80
IF ERRORLEVEL 1 ECHO MODECO FAIL ELSE ECHO MODECO OK
BIN\MODE 80
BIN\MODE CON
BIN\MODE LPT1:=COM1
IF ERRORLEVEL 1 ECHO REDIRECT FAIL OK
BIN\MODE LPT1:,,P
IF ERRORLEVEL 1 ECHO LPTRETRY FAIL ELSE ECHO LPTRETRY OK
COPY /V TEST\SAMPLE.TXT COPYV.TXT
COPY TEST\SAMPLE.TXT+TEST\SAMPLE.TXT CONCAT.TXT
FIND "HELLO" CONCAT.TXT
IF ERRORLEVEL 1 ECHO COPYCONCAT FAIL ELSE ECHO COPYCONCAT OK
MD COPYDIR
COPY TEST\*.TXT COPYDIR\
IF EXIST COPYDIR\SAMPLE.TXT ECHO COPYWILDCARD OK
TYPE NOSUCH.$$$
IF ERRORLEVEL 1 ECHO ERLVL OK
MD XS
MD XS\E
COPY TEST\SAMPLE.TXT XS\F.TXT
BIN\XCOPY XS XSD /S
IF NOT EXIST XSD\E ECHO XCOPYS SKIP OK
BIN\XCOPY XS XSE /E
IF EXIST XSE\E ECHO XCOPYE OK
BIN\ATTRIB +A TEST\SAMPLE.TXT
BIN\XCOPY TEST\SAMPLE.TXT XA.TXT /A /V
IF EXIST XA.TXT ECHO XCOPYAV OK
BIN\XCOPY TEST\SAMPLE.TXT XD.TXT /D
IF EXIST XD.TXT ECHO XCOPYD OK
MD AS
MD AS\B
COPY TEST\SAMPLE.TXT AS\T.TXT
COPY TEST\SAMPLE.TXT AS\B\U.TXT
BIN\ATTRIB +R AS\*.TXT /S
BIN\ATTRIB AS\B\*.TXT
BIN\COMP TEST\SAMPLE.TXT TEST\SAMPLE.TXT
BIN\ASSIGN E:=A:
IF EXIST E:\TEST\SAMPLE.TXT ECHO ASSIGN OK
BIN\ASSIGN /C
ECHO UTILS2 OK
